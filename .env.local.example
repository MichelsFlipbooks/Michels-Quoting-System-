# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to the browser.
# Used for PDF generation / storage upload routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud API key with Places API, Geocoding API, Distance Matrix API,
# and Maps JavaScript API enabled (Google Cloud Console > APIs & Services).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
